Options -Indexes
# Uploaded images never run code.
<IfModule mod_authz_core.c>
 <FilesMatch "\.(php|phtml|php[0-9]*|phar|cgi|pl|py|sh)$">
  Require all denied
 </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
 <FilesMatch "\.(php|phtml|php[0-9]*|phar|cgi|pl|py|sh)$">
  Order allow,deny
  Deny from all
 </FilesMatch>
</IfModule>
# Only image types may be served from here; file names are random, so a replaced image gets a new URL and can be cached for a year.
<IfModule mod_headers.c>
 Header set X-Content-Type-Options "nosniff"
 Header set Cache-Control "public, max-age=31536000, immutable"
 Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</IfModule>
